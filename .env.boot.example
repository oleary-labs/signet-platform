# boot.sh configuration — copy to .env.boot and adjust (boot.sh auto-creates
# this file from the example if it is missing).
#
# Every value has a working development default. Two are worth setting by hand
# if you want the full experience:
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — enables the dogfooded Signet
#   sign-in route. Without them the console still works; you sign in with
#   Sign-In with Ethereum instead.

# ── Ports ────────────────────────────────────────────────────────────────────
# The platform API. Not 8080: signetd binds 8080-8082 in a local devnet.
BACKEND_PORT=8088
WEB_PORT=3000
ANVIL_PORT=8545
BUNDLER_PORT=4337

# ── Chain ────────────────────────────────────────────────────────────────────
# Chain id. anvil defaults to 31337; boot.sh reads the live value after start.
CHAIN_ID=31337
# Anvil account 0 — the well-known deterministic test key. Deploys the factory
# and becomes the manager of the bootstrap group.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Anvil accounts 1-3. Only used by --no-nodes, where boot.sh registers them
# itself; the full devnet generates and registers its own node keys.
NODE_PRIVATE_KEYS=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d,0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a,0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# ── Sibling repositories ─────────────────────────────────────────────────────
# The chain, contracts, and nodes come from signet-protocol. boot.sh clones it
# to ../signet-protocol if it is missing; point these at existing checkouts to
# use those instead.
SIGNET_PROTOCOL_DIR=
SIGNET_BUNDLER_DIR=

# ── Database ─────────────────────────────────────────────────────────────────
# Left empty, boot.sh uses the Docker Postgres from docker-compose.yml
# (:5433), or falls back to a local server on :5432 when Docker is not running.
DATABASE_URL=

# ── Platform secrets ─────────────────────────────────────────────────────────
# Development values. Generate a real one with: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-not-for-production-use
# Shared key for the metering ingest endpoint the node fleet posts to.
INGEST_KEY=dev-ingest-key
# Comma-separated emails granted platform-staff rights (marketplace curation).
STAFF_EMAILS=

# ── Google OAuth (the Signet sign-in route) ──────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com with
# http://localhost:3000/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key for the bundler's /v1/prove endpoint, if it requires one.
PROVER_API_KEY=

# ── Relayer ──────────────────────────────────────────────────────────────────
# The platform deploys development groups itself, so creating one needs no
# signature from the developer. This key sends those transactions and must be
# funded. Defaults to anvil account 9, which the devnet does not use.
RELAYER_PRIVATE_KEY=

# ── Demo data ────────────────────────────────────────────────────────────────
# The account that owns the seeded demo organization. Defaults to anvil
# account 0, so signing in with that wallet lands you straight in a populated
# console.
DEMO_SUBJECT_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
