# ── Server ──────────────────────────────────────────────────────────────
# 8080 is taken by signetd in a local devnet, so the platform API sits above it.
PORT=8088
ENV=development
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/signet_platform?sslmode=disable

# ── Sessions ────────────────────────────────────────────────────────────
# Rotating this signs everyone out, which is the intended blast radius for a
# compromised key. Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=43200
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Protocol wiring ─────────────────────────────────────────────────────
# The console builds and submits its own UserOperations; the platform only
# reads the chain. Point these at a devnet (signet-protocol/devnet/start.sh)
# or a testnet deployment.
CHAIN_ID=31337

# The endpoint this server reads the chain through — group state, the node
# registry, and the manager check that attaching a group depends on. It carries
# every sync and is never published, so point it at a paid provider.
RPC_URL=http://127.0.0.1:8545

# The endpoint the browser is told to use, published as `rpc_url` in the
# unauthenticated /v1/config. Anyone who loads the site gets this value, so it
# must not be a credential you would not hand out — either a public endpoint or
# a provider key restricted to your own domain.
#
# Empty is safe: the browser needs an RPC endpoint only for the UserOperation
# path, which is inert until ACCOUNT_FACTORY_ADDRESS is set.
PUBLIC_RPC_URL=
FACTORY_ADDRESS=
# SignetAccountFactory, used by the console to derive a developer's
# counterfactual smart-account address.
ACCOUNT_FACTORY_ADDRESS=
ENTRYPOINT_ADDRESS=
BUNDLER_URL=http://127.0.0.1:4337

# ERC-7677 paymaster that sponsors group creation, so a developer's first group
# costs them nothing to deploy. Empty disables sponsorship — the platform will
# not advertise it without somewhere to ask. Sponsorship only applies to the
# UserOperation path; a transaction sent from a developer's own wallet pays its
# own gas by construction.
PAYMASTER_URL=
PAYMASTER_ADDRESS=
SPONSOR_GROUP_CREATION=true
BOOTSTRAP_GROUP=
BOOTSTRAP_NODES=http://127.0.0.1:8080,http://127.0.0.1:8081,http://127.0.0.1:8082

# ERC-4361 domain checked against every SIWE sign-in message. Leaving it empty
# disables the SIWE login route rather than accepting messages for any domain.
SIWE_DOMAIN=localhost:3000

# ── Storage ─────────────────────────────────────────────────────────────
# With IN_PRODUCTION=false uploads go to LOCAL_UPLOAD_DIR and are served by
# this server, so development needs no S3.
IN_PRODUCTION=false
LOCAL_UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=signet-platform-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# ── Metering ingest ─────────────────────────────────────────────────────
# Shared key for POST /v1/ingest/usage, called by the node fleet. Empty
# disables the endpoint entirely rather than leaving it open.
INGEST_KEY=

# ── Platform staff ──────────────────────────────────────────────────────
# Comma-separated sign-in subjects granted marketplace-curation rights.
# Subjects, not emails: a subject is proved by the sign-in signature, whereas
# users.email is an unverified profile field anyone can type.
#   SIWE    eth:0x1234…      (a bare 0x… address is read as this)
#   Signet  signet:03ab…     (the group public key)
# Case and 0x-prefix are normalised. Removing a subject revokes staff on the
# next boot; adding one takes effect on that person's next sign-in.
STAFF_SUBJECTS=

# ── Background jobs (seconds; 0 disables) ───────────────────────────────
HEALTH_PROBE_SECONDS=120
CHAIN_SYNC_SECONDS=60
