# The platform API. In development this is the Go server in ../backend.
NEXT_PUBLIC_API_URL=http://localhost:8088
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth for the dogfooded Signet sign-in route. The secret stays
# server-side and is used only by app/api/auth/token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The bundler. The console proxies to it for UserOperations and for the
# server-side prover, so the browser never talks to it directly.
NEXT_PUBLIC_BUNDLER_URL=http://127.0.0.1:4337
# Optional API key for the bundler's /v1/prove endpoint.
PROVER_API_KEY=

# Sponsor UserOperation gas through an ERC-7677 paymaster.
NEXT_PUBLIC_USE_PAYMASTER=false
